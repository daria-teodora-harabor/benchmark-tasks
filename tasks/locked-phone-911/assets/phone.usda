#usda 1.0
(
    defaultPrim = "Phone"
    doc = "Generated from layout.py by display.py (python3 render_screens.py); do not edit. Layout 1, 246 screen layers, atlas 2208 x 1552 px."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Phone" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.4
        float physics:restitution = 0
        float physics:staticFriction = 0.5
    }

    def Cube "collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Phone/PhysicsMaterial>
        uniform token purpose = "guide"
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0.0
        double size = 1
        double3 xformOp:translate = (0.000000, 0.000000, -0.008000)
        float3 xformOp:scale = (0.295000, 0.143000, 0.016000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Phone/Looks/body>
        double size = 1
        double3 xformOp:translate = (0.000000, 0.000000, -0.008500)
        float3 xformOp:scale = (0.295000, 0.143000, 0.015000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "glass" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Phone/Looks/glass>
        double size = 1
        double3 xformOp:translate = (0.000000, 0.000000, -0.000500)
        float3 xformOp:scale = (0.295000, 0.143000, 0.001000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </Phone/Looks/body/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0600, 0.0600, 0.0650)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </Phone/Looks/glass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0040, 0.0040, 0.0050)
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
    }

    def Xform "display"
    {
        def Scope "Looks"
        {
            def Material "screen"
            {
                token outputs:surface.connect = </Phone/display/Looks/screen/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.4
                    color3f inputs:emissiveColor.connect = </Phone/display/Looks/screen/atlas.outputs:rgb>
                    token outputs:surface
                }

                def Shader "uv"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "atlas"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./screen_atlas.png@
                    float2 inputs:st.connect = </Phone/display/Looks/screen/uv.outputs:result>
                    token inputs:wrapS = "clamp"
                    token inputs:wrapT = "clamp"
                    token inputs:sourceColorSpace = "sRGB"
                    float4 inputs:scale = (3.000, 3.000, 3.000, 1)
                    float3 outputs:rgb
                }
            }
        }

